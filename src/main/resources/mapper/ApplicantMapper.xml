<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.applicant_web.ApplicantMapper">

    <select id="findAllOrderByName" resultType="com.example.applicant_web.Applicant">
        SELECT id, name
        FROM applicants
        ORDER BY name ASC
    </select>

    <select id="findByNameContaining" resultType="com.example.applicant_web.Applicant">
        SELECT id, name
        FROM applicants
        WHERE name LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY name ASC
    </select>

    <select id="findById" resultType="com.example.applicant_web.Applicant">
        SELECT id, name
        FROM applicants
        WHERE id = #{id}
    </select>

    <!-- 追加したあと、自動採番されたidをApplicantのidに入れる -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO applicants (name)
        VALUES (#{name})
    </insert>

    <update id="update">
        UPDATE applicants
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM applicants
        WHERE id = #{id}
    </delete>

</mapper>